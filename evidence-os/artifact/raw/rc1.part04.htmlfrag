electSource('approval')" class="w-full text-left p-2.5 rounded bg-carbon-850 border border-white/10 hover:border-accent-blue transition-colors flex items-center justify-between group" id="src-approval">
                  <div class="truncate">
                    <span class="text-steel-300 group-hover:text-white block font-medium">Approval Record</span>
                    <span class="text-[10px] text-steel-400">APPROVAL RECORD // DEMO</span>
                  </div>
                  <span class="w-1.5 h-1.5 rounded-full bg-steel-400"></span>
                </button>
              </div>
            </div>

            <!-- Center Column: Verification Graph -->
            <div class="lg:col-span-6 p-6 flex flex-col justify-between font-mono bg-carbon-900/40 relative">
              <div class="flex items-center justify-between text-xs text-steel-400 mb-6">
                <span>VERIFICATION GRAPH</span>
                <span class="text-[10px] text-steel-400">SOURCE → CLAIM → DECISION → ACTION</span>
              </div>

              <!-- Visual Graph Pipeline -->
              <div class="space-y-4 my-auto">
                <div class="p-3 bg-carbon-950 border border-white/10 rounded flex items-center justify-between">
                  <div>
                    <span class="text-[10px] text-steel-400 block font-bold">SOURCE</span>
                    <span class="text-xs text-white" id="graphSourceVal">Contract.pdf [Cláusula Operativa 14.2]</span>
                  </div>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-steel-300">INPUT SOURCE</span>
                </div>

                <div class="flex justify-center text-steel-400 font-bold text-xs">↓</div>

                <div class="p-3 bg-carbon-950 border border-white/10 rounded flex items-center justify-between">
                  <div>
                    <span class="text-[10px] text-steel-400 block font-bold">CLAIM</span>
                    <span class="text-xs text-white" id="graphClaimVal">"El contratista debe operar en umbral de 42.5 MW"</span>
                  </div>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-accent-blue/10 border border-accent-blue/30 text-accent-blue">CLAIM EXTRACTED</span>
                </div>

                <div class="flex justify-center text-steel-400 font-bold text-xs">↓</div>

                <div class="p-3 bg-carbon-950 border border-white/10 rounded flex items-center justify-between">
                  <div>
                    <span class="text-[10px] text-steel-400 block font-bold">DECISION</span>
                    <span class="text-xs text-white" id="graphDecisionVal">Aprobación de sobrepaso temporal por Gerencia Técnica</span>
                  </div>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/15 text-steel-300">AUTHORITY LINKED</span>
                </div>

                <div class="flex justify-center text-steel-400 font-bold text-xs">↓</div>

                <div class="p-3 bg-carbon-950 border border-white/10 rounded flex items-center justify-between">
                  <div>
                    <span class="text-[10px] text-steel-400 block font-bold">ACTION</span>
                    <span class="text-xs text-white" id="graphActionVal">Ajuste de turbina registrado a las 14:32 UTC</span>
                  </div>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/15 text-steel-300">ACTION RECORD</span>
                </div>
              </div>

              <div class="text-[11px] text-steel-400 pt-4 border-t border-white/10 flex items-center justify-between">
                <span>RECONSTRUCTION GRAPH DEMO</span>
                <span class="text-steel-400">SYNTHETIC FLOW</span>
              </div>
            </div>

            <!-- Right Column: Evidentiary Status Taxonomy -->
            <div class="lg:col-span-3 p-5 bg-carbon-950/60 font-mono">
              <div class="text-xs font-bold text-steel-300 uppercase tracking-wider mb-1">
                EVIDENTIARY STATUS TAXONOMY
              </div>
              <p class="text-[10px] text-steel-400 mb-3">
                Illustrative classifications used to distinguish evidentiary states.
              </p>

              <div class="space-y-1.5 text-[11px]">
                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-white">VERIFIED</span>
                  <span class="text-[9px] text-accent-emerald">● STATE</span>
                </div>

                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-steel-200">SOURCE_BACKED</span>
                  <span class="text-[9px] text-accent-emerald">● STATE</span>
                </div>

                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-steel-300">PARTIALLY_SUPPORTED</span>
                  <span class="text-[9px] text-accent-amber">▲ STATE</span>
                </div>

                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-steel-300">RECONSTRUCTED</span>
                  <span class="text-[9px] text-accent-blue">◆ STATE</span>
                </div>

                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-steel-400">INFERRED</span>
                  <span class="text-[9px] text-steel-400">◇ STATE</span>
                </div>

                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-steel-400">UNVERIFIED</span>
                  <span class="text-[9px] text-accent-amber">○ STATE</span>
                </div>

                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-steel-400">CONTRADICTED</span>
                  <span class="text-[9px] text-accent-crimson">✕ STATE</span>
                </div>

                <div class="p-1.5 px-2 rounded bg-carbon-850 border border-white/10 flex items-center justify-between">
                  <span class="text-steel-400">UNKNOWN</span>
                  <span class="text-[9px] text-steel-400">? STATE</span>
                </div>
              </div>
            </div>

          </div>

        </div>

        <!-- Section Footer Statement -->
        <div class="mt-8 text-center">
          <p class="font-mono text-sm sm:text-base text-steel-300">
            El objetivo no es producir más información. <br class="hidden sm:inline" />
            <span class="text-white font-semibold">Es distinguir, con evidencia explícita, qué puede sostenerse, qué permanece incierto y qué requiere verificación adicional.</span>
          </p>
        </div>

      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 6: CASOS DE USO -->
    <!-- ========================================================================= -->
    <section id="casos-de-uso" class="py-24 bg-carbon-900 border-t border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mb-16">
          <div class="text-xs font-mono text-accent-blue uppercase tracking-widest mb-3">APLICABILIDAD SECTORIAL</div>
