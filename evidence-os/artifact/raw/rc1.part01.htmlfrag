         </div>
                <span class="font-mono text-[10px] text-steel-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">CONCEPTUAL</span>
              </div>

              <div class="mb-4">
                <span class="text-[10px] font-mono text-steel-400 uppercase tracking-wider block">SYNTHETIC EXAMPLE — NOT PRODUCTION DATA</span>
              </div>

              <!-- Illustrative Chain Pipeline -->
              <div class="space-y-3 relative font-mono text-xs">
                <!-- Source Node -->
                <div class="flex items-center justify-between p-2.5 rounded bg-carbon-850 border border-white/10">
                  <div class="flex items-center gap-3">
                    <span class="text-[10px] text-steel-400 font-bold w-4">01</span>
                    <span class="text-white font-medium">SOURCE</span>
                    <span class="text-[10px] text-steel-400">[Telemetry / Contract / Model Log]</span>
                  </div>
                  <span class="text-[10px] font-mono text-steel-300">SOURCE IDENTIFIED</span>
                </div>

                <div class="w-px h-2.5 bg-white/20 mx-auto"></div>

                <!-- Evidence Node -->
                <div class="flex items-center justify-between p-2.5 rounded bg-carbon-850 border border-white/10">
                  <div class="flex items-center gap-3">
                    <span class="text-[10px] text-steel-400 font-bold w-4">02</span>
                    <span class="text-white font-medium">EVIDENCE</span>
                    <span class="text-[10px] text-steel-400">[Preserved Audit Record]</span>
                  </div>
                  <span class="text-[10px] font-mono text-accent-cyan">EVIDENCE LINKED</span>
                </div>

                <div class="w-px h-2.5 bg-white/20 mx-auto"></div>

                <!-- Claim Node -->
                <div class="flex items-center justify-between p-2.5 rounded bg-carbon-850 border border-white/10">
                  <div class="flex items-center gap-3">
                    <span class="text-[10px] text-steel-400 font-bold w-4">03</span>
                    <span class="text-white font-medium">CLAIM</span>
                    <span class="text-[10px] text-steel-400">[Assertion of Fact / Metric]</span>
                  </div>
                  <span class="text-[10px] font-mono text-steel-300">CLAIM MAPPED</span>
                </div>

                <div class="w-px h-2.5 bg-white/20 mx-auto"></div>

                <!-- Decision Node -->
                <div class="flex items-center justify-between p-2.5 rounded bg-carbon-850 border border-accent-blue/40 bg-accent-blue/5">
                  <div class="flex items-center gap-3">
                    <span class="text-[10px] text-accent-blue font-bold w-4">04</span>
                    <span class="text-white font-semibold">DECISION</span>
                    <span class="text-[10px] text-accent-blue/80">[Governance Authority]</span>
                  </div>
                  <span class="text-[10px] font-mono text-accent-blue">DECISION CONTEXT</span>
                </div>

                <div class="w-px h-2.5 bg-white/20 mx-auto"></div>

                <!-- Action Node -->
                <div class="flex items-center justify-between p-2.5 rounded bg-carbon-850 border border-white/10">
                  <div class="flex items-center gap-3">
                    <span class="text-[10px] text-steel-400 font-bold w-4">05</span>
                    <span class="text-white font-medium">ACTION</span>
                    <span class="text-[10px] text-steel-400">[Operational Execution]</span>
                  </div>
                  <span class="text-[10px] font-mono text-steel-300">ACTION RECORDED</span>
                </div>

                <div class="w-px h-2.5 bg-white/20 mx-auto"></div>

                <!-- Result Node -->
                <div class="flex items-center justify-between p-2.5 rounded bg-carbon-850 border border-white/15 bg-carbon-800/50">
                  <div class="flex items-center gap-3">
                    <span class="text-[10px] text-steel-300 font-bold w-4">06</span>
                    <span class="text-white font-semibold">RESULT</span>
                    <span class="text-[10px] text-steel-400">[Measurable Outcome]</span>
                  </div>
                  <span class="text-[10px] font-mono text-steel-300">RESULT OBSERVED</span>
                </div>
              </div>

              <!-- Terminal Status Line -->
              <div class="mt-5 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-steel-400">
                <span class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-steel-400"></span>
                  ILLUSTRATIVE RECONSTRUCTION COMPLETE
                </span>
                <span class="text-steel-400 font-mono text-[10px]">CONCEPT MODEL</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 2: EL PROBLEMA -->
    <!-- ========================================================================= -->
    <section id="problema" class="py-24 bg-carbon-900 border-t border-b border-white/10 relative">
